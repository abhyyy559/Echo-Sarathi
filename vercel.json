{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://echosarathi-api.onrender.com/api/:path*"
    },
    {
      "source": "/api",
      "destination": "https://echosarathi-api.onrender.com/api"
    },
    {
      "source": "/vobiz/:path*",
      "destination": "https://echosarathi-api.onrender.com/vobiz/:path*"
    },
    {
      "source": "/twilio/:path*",
      "destination": "https://echosarathi-api.onrender.com/twilio/:path*"
    },
    {
      "source": "/internal/:path*",
      "destination": "https://echosarathi-api.onrender.com/internal/:path*"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
