# Local-only deployment credentials. NEVER commit this file (.gitignore).
# Fill the blanks, then run: powershell -ExecutionPolicy Bypass -File scripts\deploy\deploy-all.ps1

# --- Render (dashboard: Account Settings -> API Keys) ---
RENDER_API_KEY=
# Optional: paste the workspace ID from Render Settings; the script can look it up.
RENDER_OWNER_ID=
RENDER_SERVICE_NAME=echosarathi-api
RENDER_REGION=singapore

# --- Neon Postgres (console.neon.tech -> your project -> Connect) ---
# Use the POOLED connection string and keep sslmode=require.
DATABASE_URL=

# --- LiveKit Cloud (cloud.livekit.io -> Project Settings -> Keys) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_REGION=ap-south

# --- Vercel (vercel.com/account/tokens) ---
VERCEL_TOKEN=
VERCEL_PROJECT_ID=prj_3JDqXzV5LMIcEoQZetSjS9qH08K4
VERCEL_ORG_ID=team_rUAivKclymEzXORkdFj5Ic3V
# Optional. Leave blank to auto-detect from the Vercel project domains.
APP_ORIGIN=

# --- Generated for this deployment (do not reuse elsewhere) ---
JWT_SECRET=
INTERNAL_API_TOKEN=
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=

# --- Optional: "Sign in with Google" OAuth client id ---
GOOGLE_CLIENT_ID=
