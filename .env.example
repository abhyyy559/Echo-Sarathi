# VocalIQ environment template — copy to `.env` and fill in real values.
# NEVER commit the real `.env`.

# --- Core ---
ENVIRONMENT=development
LOG_LEVEL=info

# Public base URL for Twilio/Vobiz webhooks + media-stream websockets.
# For local demos: run tools/cloudflared tunnel --url http://localhost:8000
# and paste the https URL here (tunnel URL changes on every restart).
PUBLIC_BASE_URL=http://localhost:8000
PUBLIC_WS_BASE_URL=
JWT_SECRET=change_me_long_random_string
INTERNAL_API_TOKEN=change_me_internal_token
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001
# Google OAuth client id ("Sign in with Google"). Empty disables the Google
# button and /api/auth/google. The frontend build needs the same value as
# VITE_GOOGLE_CLIENT_ID — put that in frontend/.env.local locally, and in the
# Vercel project's environment variables for deployments.
GOOGLE_CLIENT_ID=

# --- Demo tenant created by scripts/seed_demo.py ---
# Set a non-default password on any internet-exposed deployment.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo1234

# --- Data stores (compose service names when using Docker) ---
DATABASE_URL=postgresql://postgres:postgres@db:5432/voice_agent
# The dialer and campaign queue are Postgres-backed; no Redis is used.

# --- LiveKit (real-time voice rooms) ---
# LiveKit Cloud is the single room server (browser tokens AND server-side
# bridges both use it — there is no self-hosted livekit service anymore).
LIVEKIT_URL=wss://echo-sarathi-2hya0f27.livekit.cloud
LIVEKIT_API_KEY=API545VCF8d9jKF
LIVEKIT_API_SECRET=paste-from-livekit-cloud-dashboard
# Same cloud URL for container-side joins (bridges, worker):
LIVEKIT_URL_INTERNAL=wss://echo-sarathi-2hya0f27.livekit.cloud
# Fully-offline fallback (uncomment the retired compose service too):
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret_for_local_dev_only
# LIVEKIT_URL_INTERNAL=ws://livekit:7880

# --- Speech / LLM providers ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
GROQ_API_KEY=
# Extra Groq keys (comma-separated, no spaces needed). Both the voice worker
# and the text playground rotate through GROQ_API_KEY first, then each key
# here, when a key hits 429/quota — paste all the keys you have so one
# exhausted key never silences a call. Example: GROQ_API_KEYS=gsk_aaa,gsk_bbb
GROQ_API_KEYS=
# Primary voice/text model. qwen3.8-27b measured 6/6 correct tool decisions,
# multi-field capture, speech on tool turns, <2.3s. llama-3.1-8b-instant is
# 404 (decommissioned for dev tiers, Aug 2026). gpt-oss-* are reasoning
# models: silent on most tool turns and expensive against the TPM cap.
GROQ_MODEL=qwen/qwen3.8-27b
# Secondary MODEL after every primary key has failed (quality tier, not extra
# quota). Leave blank to disable. Only armed on api.groq.com.
GROQ_SECONDARY_MODEL=openai/gpt-oss-120b
# Fastest-LLM swap: any OpenAI-compatible endpoint works, but the secondary
# Groq model is skipped automatically when the base URL is not Groq.
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- LLM provider chain (fixes "agent goes silent after 4-6 turns") ---
# Primary voice members, tried BEFORE the Groq pool. Measured on the full
# 2.7k-token production prompt: sarvam-105b answered in 0.5-0.65s sustained,
# while Groq's org-wide 8000 TPM bucket allows only ~2-3 turns a minute. The
# bare word "sarvam" expands from SARVAM_API_KEY / SARVAM_TTS_API, so the key
# is pasted once. Any explicit `name|base_url|key|model` entry also works.
# Empty keeps the historical Groq-first order.
LLM_PRIMARY_CHAIN=sarvam
SARVAM_LLM_MODEL=sarvam-105b-conversations
# One free-tier Groq key 429s mid-call; the text playground and the voice
# worker then walk this chain instead of failing. Format per entry:
#   name|base_url|key|model      (comma-separated; use "|" not ":" because
#                                OpenRouter model ids end in ":free")
# ORDER with a primary set: Sarvam -> Groq primary keys (qwen) -> secondary
# Groq model (gpt-oss-120b) -> the explicit entries below -> shorthand keys.
# Sarvam example (when it is not already the primary; same key as
# SARVAM_TTS_API):
# LLM_FALLBACK_CHAIN=sarvam|https://api.sarvam.ai/v1|YOUR_SARVAM_KEY|sarvam-105b-conversations
LLM_FALLBACK_CHAIN=
# Sarvam key (Phase 2 TTS and the optional LLM overflow above). Reuse the same
# value in both places; leave blank to disable Sarvam entirely.
SARVAM_TTS_API=
# --- Voice TTS routing ---
# Non-English agent languages (te, hi, ...) are forced onto Sarvam Bulbul even
# when Cartesia is selected: Cartesia/Aura mangle Indian names and cannot
# code-switch Telugu-English. English keeps TTS_PROVIDER below.
TTS_PROVIDER=cartesia
TTS_LANGUAGE_ROUTING=on
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_LANG=en-IN
# 8000 = telephony narrowband; use 22050 for browser-only demos.
SARVAM_TTS_SAMPLE_RATE=8000
# --- STT routing + latency knobs ---
# STT provider. deepgram = English default (Nova-3, fastest); sarvam = force
# Sarvam Saaras everywhere.
STT_PROVIDER=deepgram
# Non-English agent languages (te, hi) are promoted to Sarvam Saaras at te-IN /
# hi-IN automatically: Nova-3 has no Indian streaming models, so leaving them on
# Deepgram transcribes callers as English gibberish. off = strict STT_PROVIDER.
STT_LANGUAGE_ROUTING=on
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_LANG=en-IN
# Turn-close endpointing (seconds). Lower = snappier but riskier: the caller's
# own pause mid-sentence can end the turn early and the agent talks over them.
# Sarvam STT defaults to 0.07 (its flush_signal marks speech end); Deepgram 0.3
# (raised from 0.25 to stop looped-back TTS from hair-triggering a retrigger).
VOICE_MIN_ENDPOINTING_DELAY=
VOICE_MAX_ENDPOINTING_DELAY=2.5
# Speculative LLM generation while the caller is still finishing. auto = on for
# browser rooms, off for phone rooms (a barge-in mid-speculation costs a retry).
# on/off force it either way.
VOICE_PREEMPTIVE_GENERATION=auto
# Swap the full system prompt (~2250 tokens) for the compact instructions
# (~208) from this turn onward. Lower = cheaper on the shared TPM budget and
# faster first token; the full prompt is still sent for turn 0 so the agent
# starts with complete information.
VOICE_COMPACT_AFTER_TURNS=1
# Voice-focus input conditioning before turn detection: hush (bundled) or
# ai_coustics (optional livekit-plugins-ai-coustics install), or auto.
VOICE_NC=on
VOICE_NC_PROVIDER=hush
# Shorthand keys: if set, these are appended to the chain automatically
# (DeepSeek, then OpenAI, then Cerebras, then OpenRouter free tier).
# NOTE: DeepSeek API is billed, not free - a zero balance answers 402 and the
# chain skips it after one attempt per session. Leave blank until funded.
DEEPSEEK_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Telephony (provider: "" | twilio | vobiz) ---
TELEPHONY_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_VALIDATE_SIGNATURE=false
# --- Telephony (Vobiz: India CPaaS, REST + XML <Stream> websockets) ---
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_PHONE_NUMBER=+91XXXXXXXXXX

# --- Public URLs (tunnel for Twilio webhooks + media stream) ---
PUBLIC_BASE_URL=http://localhost:8000
PUBLIC_WS_BASE_URL=

# --- Calling policy ---
TIMEZONE=Asia/Kolkata
CALLING_HOURS_START=9
CALLING_HOURS_END=21
TEST_PHONE_NUMBERS=
CONSENT_ENFORCEMENT=true
# Test calls may dial any valid number. Set false to cap them to
# TEST_PHONE_NUMBERS + consented roster contacts. Campaign dialing always
# requires per-contact consent.
ALLOW_ANY_OUTBOUND_NUMBER=true
DIALER_ENABLED=true
DEFAULT_CPS_LIMIT=1.0
DEFAULT_CONCURRENCY_LIMIT=10
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_MINUTES=15
# Render free web services sleep after 15 min without inbound HTTP. While any
# campaign is running the dialer pings PUBLIC_BASE_URL this often so a closed
# browser tab (or an overnight pause in calling hours) cannot stop the roster.
# 0 disables the ping.
KEEPALIVE_INTERVAL_SECONDS=600

# --- Retention ---
RECORDING_RETENTION_DAYS=90
RETENTION_JOB_ENABLED=true

# --- Billing (prepaid credits) ---
# When false (production default), POST /api/billing/topup refuses: operator
# top-ups only. Customer purchases use Razorpay checkout (below).
ALLOW_MANUAL_PAYMENTS=false
# Razorpay checkout. With these empty the Buy buttons are disabled and nothing
# is ever credited without a payment. Get test keys from the Razorpay dashboard;
# the webhook secret comes from the Razorpay webhook configuration.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# --- SaaS plans, invoices, team invites ---
# Public app URL used in invite/reset/invoice links. Must be the real frontend
# origin in production, or every emailed link points at localhost.
FRONTEND_BASE_URL=http://localhost:5173
# Transactional email over SMTP. Empty SMTP_HOST disables delivery: invite and
# reset links are logged instead (never the password/token values themselves).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Echo Sarathi <hello@echosarathi.ai>
SMTP_TLS=true
# Seller block printed on GST invoices.
COMPANY_LEGAL_NAME=
COMPANY_GSTIN=
COMPANY_ADDRESS=
COMPANY_STATE=
# Comma-separated emails allowed into the platform admin console (empty = none).
PLATFORM_ADMIN_EMAILS=
# Hours between plan-expiry/renewal-reminder ticks; 0 disables the loop.
BILLING_LIFECYCLE_INTERVAL_HOURS=6

# --- Domain configs mount (compose sets this literal) ---
DOMAIN_CONFIGS_DIR=/domain-configs
CARTESIA_PRONUNCIATION_DICT_ID=pdict_QkAFhjrJU5NXL8FKLGWT3V
