# VocalIQ environment template — copy to `.env` and fill in real values.
# NEVER commit the real `.env`.

# --- Core ---
ENVIRONMENT=development
LOG_LEVEL=info

# Public base URL for Twilio/Plivo webhooks + media-stream websockets.
# For local demos: run tools/cloudflared tunnel --url http://localhost:8000
# and paste the https URL here (tunnel URL changes on every restart).
PUBLIC_BASE_URL=http://localhost:8000
PUBLIC_WS_BASE_URL=
JWT_SECRET=change_me_long_random_string
INTERNAL_API_TOKEN=change_me_internal_token
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001

# --- Data stores (compose service names when using Docker) ---
DATABASE_URL=postgresql://postgres:postgres@db:5432/voice_agent
REDIS_URL=redis://redis:6379/0

# --- LiveKit (real-time voice rooms) ---
# LiveKit Cloud is the single room server (browser tokens AND server-side
# bridges both use it — there is no self-hosted livekit service anymore).
LIVEKIT_URL=wss://echo-sarathi-2hya0f27.livekit.cloud
LIVEKIT_API_KEY=API545VCF8d9jKF
LIVEKIT_API_SECRET=paste-from-livekit-cloud-dashboard
# Same cloud URL for container-side joins (bridges, worker):
LIVEKIT_URL_INTERNAL=wss://echo-sarathi-2hya0f27.livekit.cloud
# Fully-offline fallback (uncomment the retired compose service too):
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret_for_local_dev_only
# LIVEKIT_URL_INTERNAL=ws://livekit:7880

# --- Speech / LLM providers ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
GROQ_API_KEY=
# Extra Groq keys (comma-separated, no spaces needed). Both the voice worker
# and the text playground rotate through GROQ_API_KEY first, then each key
# here, when a key hits 429/quota — paste all the keys you have so one
# exhausted key never silences a call. Example: GROQ_API_KEYS=gsk_aaa,gsk_bbb
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-20b
# Fastest-LLM swap: any OpenAI-compatible endpoint works. Groq free tier
# 429s under call load — fix it with a Groq Dev-tier key, extra keys above,
# or Cerebras (fastest inference right now): GROQ_BASE_URL=https://api.cerebras.ai/v1
# with Cerebras keys in GROQ_API_KEY(S) and GROQ_MODEL=llama-3.1-8b.
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- LLM provider chain (fixes "agent goes silent after 4-6 turns") ---
# One free-tier Groq key 429s mid-call; the text playground and the voice
# worker then walk this chain instead of failing. Format per entry:
#   name|base_url|key|model      (comma-separated; use "|" not ":" because
#                                OpenRouter model ids end in ":free")
# Add as many free/cheap providers as you have keys for. ORDER: explicit
# entries first (your listed order), then DeepSeek, then Groq keys, then the
# remaining shorthands. So "gemini|...|..." + DEEPSEEK_API_KEY reads
# gemini -> deepseek -> groq.
# Examples:
# LLM_FALLBACK_CHAIN=cerebras|https://api.cerebras.ai/v1|YOUR_CEREBRAS_KEY|llama-3.3-70b,openrouter|https://openrouter.ai/api/v1|YOUR_OPENROUTER_KEY|meta-llama/llama-3.3-70b-instruct:free
LLM_FALLBACK_CHAIN=
# Shorthand keys: if set, these are appended to the chain automatically
# (DeepSeek, then OpenAI, then Cerebras, then OpenRouter free tier).
# NOTE: DeepSeek API is billed, not free - a zero balance answers 402 and the
# chain skips it after one attempt per session.
DEEPSEEK_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Telephony (provider: "" | twilio | plivo | vobiz) ---
TELEPHONY_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_VALIDATE_SIGNATURE=false
# --- Telephony (Vobiz: India CPaaS, REST + XML <Stream> websockets) ---
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_PHONE_NUMBER=+91XXXXXXXXXX

# --- Public URLs (tunnel for Twilio webhooks + media stream) ---
PUBLIC_BASE_URL=http://localhost:8000
PUBLIC_WS_BASE_URL=

# --- Calling policy ---
TIMEZONE=Asia/Kolkata
CALLING_HOURS_START=9
CALLING_HOURS_END=21
TEST_PHONE_NUMBERS=
CONSENT_ENFORCEMENT=true
DIALER_ENABLED=true
DEFAULT_CPS_LIMIT=1.0
DEFAULT_CONCURRENCY_LIMIT=10
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_MINUTES=15

# --- Retention ---
RECORDING_RETENTION_DAYS=90
RETENTION_JOB_ENABLED=true

# --- Domain configs mount (compose sets this literal) ---
DOMAIN_CONFIGS_DIR=/domain-configs
CARTESIA_PRONUNCIATION_DICT_ID=pdict_QkAFhjrJU5NXL8FKLGWT3V
